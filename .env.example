# Banco PostgreSQL local (Docker): docker compose up -d
# Porta 5434 no host (evita conflito com outros Postgres na 5432)
DATABASE_URL="postgresql://pallazium:pallazium@localhost:5434/pallazium?schema=public"

# Reservado para uso futuro (sessões hoje ficam no banco)
SESSION_SECRET="gere-uma-string-longa-e-aleatoria"

# Uploads de imagens/PDFs no disco do servidor
UPLOAD_DIR="uploads"
PUBLIC_UPLOAD_URL="/uploads"

# WhatsApp de suporte (exibido no app)
VITE_WHATSAPP_SUPPORT="5511999999999"

# Leads — tracking / CRM (também editáveis em /admin/leads/integracoes)
LEAD_GTM_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""
